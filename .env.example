# KenRadar local secrets and machine-specific values.
# Copy this file to .env and fill in local values. Never commit .env.

# PostgreSQL connection string. If omitted, config/config.yaml is used.
DATABASE_URL=postgresql://KenRadar:CHANGE_ME@localhost:5432/KenRadar

# Agnes AI primary organizer key.
AGNES_API_KEY=sk-CHANGE_ME

# Feishu bot webhook.
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/CHANGE_ME

# Optional publishing URL for generated GitHub Pages links.
KENRADAR_GITHUB_PAGES_URL=
