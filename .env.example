# KenRadar local secrets and machine-specific values.
# Copy this file to .env and fill in local values. Never commit .env.

# SQLite file URL. Leave empty to use config/config.yaml.
DATABASE_URL=

# Agnes AI primary organizer key.
AGNES_API_KEY=

# Feishu bot webhook.
FEISHU_WEBHOOK_URL=

# Optional publishing URL for generated GitHub Pages links.
KENRADAR_GITHUB_PAGES_URL=

# FunASR: auto selects CUDA only when the installed PyTorch supports it.
FUNASR_DEVICE=auto
FUNASR_HOST=127.0.0.1
FUNASR_PORT=18002
FUNASR_MODEL=paraformer-zh
FUNASR_VAD_MODEL=fsmn-vad
FUNASR_PUNC_MODEL=ct-punc
FUNASR_IDLE_TIMEOUT_SECONDS=300
